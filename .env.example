# Copy to .env (gitignored) or ~/.jobhunt/.env. Only scripts read this file, never the agents.
# Prefer API tokens and keys. Do NOT store site passwords here unless you accept plain text on disk.
# Agents never type passwords: log in to sites yourself in the browser.

# hh.ru / rabota.by API (optional, see scripts/hh_api.py). Get the app at https://dev.hh.ru
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=
HH_TOKEN=

# Optional keys for other APIs (not wired up yet)
SUPERJOB_SECRET_KEY=
JOOBLE_API_KEY=
